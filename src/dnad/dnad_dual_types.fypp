#:def dnad_dual_type(kind, real_kind, size_dx, statement = "")
    type :: dual__${kind.suffix}$_t
        !! dual number type
        ${statement}$
        real(${real_kind}$) :: f = 0  ! functional value
        real(${real_kind}$) :: g(${size_dx}$) = 0  ! derivatives
    end type
  #:if kind.hyper
    type :: hdual__${kind.suffix}$_t
        !! hyper-dual number type
        ${statement}$
        type(dual__${kind.suffix}$_t) :: d  ! dual number
        real(${real_kind}$) :: h(${size_dx}$*(${size_dx}$ + 1)/2) = 0  ! Lower triangular of Hessian
    end type
  #:endif
#:enddef
