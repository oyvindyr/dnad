#! The implementations of the catalog in dnad/__init__.py. A family's <family>_d macro writes the procedures
#! of one dual number, <family>_hd those of one hyper-dual number. Files ending with _gen.fypp are
#! generated from sympy by fortran_gen.py.
#:include 'dnad_helpers.fypp'
#:include 'assign.fypp'
#:include 'add_gen.fypp'
#:include 'minus_gen.fypp'
#:include 'mult_gen.fypp'
#:include 'div_gen.fypp'
#:include 'pow.fypp'
#:include 'hypot.fypp'
#:include 'eq.fypp'
#:include 'le.fypp'
#:include 'lt.fypp'
#:include 'ge.fypp'
#:include 'gt.fypp'
#:include 'ne.fypp'
#:include 'log_gen.fypp'
#:include 'sqrt.fypp'
#:include 'math.fypp'

#:def dnad_overload_implementations(kinds, config, selection=None)
  #:set impl = dnad.implementations(kinds, config, selection)
$:instances(assign_d, impl['assign'].d)
$:instances(assign_hd, impl['assign'].hd)
$:instances(add_d, impl['add'].d)
$:instances(add_hd, impl['add'].hd)
$:instances(minus_d, impl['minus'].d)
$:instances(minus_hd, impl['minus'].hd)
$:instances(mult_d, impl['mult'].d)
$:instances(mult_hd, impl['mult'].hd)
$:instances(div_d, impl['div'].d)
$:instances(div_hd, impl['div'].hd)
$:instances(pow_d, impl['pow'].d)
$:instances(pow_hd, impl['pow'].hd)
$:instances(hypot_d, impl['hypot'].d)
$:instances(hypot_hd, impl['hypot'].hd)
$:instances(eq, impl['eq'].d)
$:instances(eq, impl['eq'].hd)
$:instances(le, impl['le'].d)
$:instances(le, impl['le'].hd)
$:instances(lt, impl['lt'].d)
$:instances(lt, impl['lt'].hd)
$:instances(ge, impl['ge'].d)
$:instances(ge, impl['ge'].hd)
$:instances(gt, impl['gt'].d)
$:instances(gt, impl['gt'].hd)
$:instances(ne, impl['ne'].d)
$:instances(ne, impl['ne'].hd)
$:instances(abs_d, impl['abs'].d)
$:instances(acos_d, impl['acos'].d)
$:instances(asin_d, impl['asin'].d)
$:instances(atan_d, impl['atan'].d)
$:instances(atan2_d, impl['atan2'].d)
$:instances(cos_d, impl['cos'].d)
$:instances(dot_product_d, impl['dot_product'].d)
$:instances(exp_d, impl['exp'].d)
$:instances(int_d, impl['int'].d)
$:instances(log_d, impl['log'].d)
$:instances(log_hd, impl['log'].hd)
$:instances(log10_d, impl['log10'].d)
$:instances(matmul_d, impl['matmul'].d)
$:instances(max_d, impl['max'].d)
$:instances(dmax1_d, impl['dmax1'].d)
$:instances(maxval_d, impl['maxval'].d)
$:instances(min_d, impl['min'].d)
$:instances(dmin1_d, impl['dmin1'].d)
$:instances(minval_d, impl['minval'].d)
$:instances(nint_d, impl['nint'].d)
$:instances(sign_d, impl['sign'].d)
$:instances(sin_d, impl['sin'].d)
$:instances(tan_d, impl['tan'].d)
$:instances(sqrt_d, impl['sqrt'].d)
$:instances(sqrt_hd, impl['sqrt'].hd)
$:instances(sum_d, impl['sum'].d)
$:instances(maxloc_d, impl['maxloc'].d)
#:enddef
