#! Everything a module needs to compute with a set of dual types, in two calls: dnad_module_spec in the
#! specification part and dnad_module_impl after contains, with the same arguments.
#!
#!   kinds      dnad.Kind objects: dual__<suffix>_t for each, and hdual__<suffix>_t for the hyper ones
#!   config     dnad.Config: real kind, stringent, pure
#!   selection  the interface keys to overload (dnad.all_interfaces), or None for all of them
#!   chains     (y, x) Kind pairs for chain_duals (see dnad_chain_duals.fypp)
#!
#:include 'dnad_initialize.fypp'
#:include 'dnad_getters.fypp'
#:include 'dnad_jacobi.fypp'
#:include 'dnad_chain_duals.fypp'
#:include 'dnad_overload_interfaces.fypp'
#:include 'dnad_overload_implementations.fypp'

#:def dnad_module_spec(kinds, config, selection=None, chains=())
$:dnad_initialize_interface(kinds)
$:dnad_getter_interfaces(kinds)
$:dnad_jacobi_interfaces(kinds)
  #:if chains
$:dnad_chain_duals_interface(chains)
  #:endif
$:dnad_overload_interfaces(kinds, config, selection)
  #:if config.stringent
    real(${config.real_kind}$) :: negative_one = -1.0_${config.real_kind}$ ! Lets pure procedures produce NaN deliberately
  #:endif
#:enddef

#:def dnad_module_impl(kinds, config, selection=None, chains=())
$:dnad_initialize_implementations(kinds, config)
$:dnad_getter_implementations(kinds, config)
$:dnad_jacobi_implementations(kinds, config)
  #:if chains
$:dnad_chain_duals_implementations(chains, config)
  #:endif
$:dnad_overload_implementations(kinds, config, selection)
  #:if config.stringent
    elemental function set_NaN() result(res)
        real(${config.real_kind}$) :: res
        res = sqrt(negative_one)
    end function set_NaN
  #:endif
#:enddef
