    
#:def dnad_initialize_interface(kinds)
    interface initialize 
        !! Initialize a dual or hyper dual number
      #:for k in kinds
        module procedure initialize__d_${k.suffix}$_scalar
        module procedure initialize__d_${k.suffix}$_vector
       #:if k.hyper
        module procedure initialize__hd_${k.suffix}$_scalar
        module procedure initialize__hd_${k.suffix}$_vector
       #:endif
      #:endfor
    end interface
#:enddef

#:def dnad_initialize_implementations(kinds, config)
  #:for k in kinds
    pure subroutine initialize__d_${k.suffix}$_scalar(dual, val, idiff)
        !! Initialize a single dual number, whose derivative with respect to design variable 'idiff' is 1
        type(dual__${k.suffix}$_t), intent(out) :: dual
        real(${config.real_kind}$), intent(in) :: val
        integer, intent(in) :: idiff
        
        dual%f = val
        dual%g = 0
        dual%g(idiff) = 1

    end subroutine
    pure subroutine initialize__d_${k.suffix}$_vector(dual, val)
        !! Initialize a vector of dual numbers, where the derivative of 
        !! number i with respect to design variable i is 1
        type(dual__${k.suffix}$_t), intent(out) :: dual(:)
        real(${config.real_kind}$), intent(in) :: val(:)

        integer :: i

        do i = 1, size(dual)
            dual(i)%f = val(i)
            dual(i)%g = 0
            dual(i)%g(i) = 1
        end do

    end subroutine
   #:if k.hyper
    pure subroutine initialize__hd_${k.suffix}$_scalar(hdual, val, idiff)
        !! Initialize a single hyper-dual number, whose derivative with respect to design variable 'idiff' is 1
        type(hdual__${k.suffix}$_t), intent(out) :: hdual
        real(${config.real_kind}$), intent(in) :: val
        integer, intent(in) :: idiff
        
        hdual%d%f = val
        hdual%d%g = 0
        hdual%h = 0
        hdual%d%g(idiff) = 1

    end subroutine
    pure subroutine initialize__hd_${k.suffix}$_vector(hdual, val)
        !! Initialize a vector of hyper-dual numbers, where the derivative of 
        !! number i with respect to design variable i is 1
        type(hdual__${k.suffix}$_t), intent(out) :: hdual(:)
        real(${config.real_kind}$), intent(in) :: val(:)

        integer :: i
        
        do i = 1, size(hdual)
            hdual(i)%d%f = val(i)
            hdual(i)%d%g = 0
            hdual(i)%h = 0
            hdual(i)%d%g(i) = 1
        end do

    end subroutine
   #:endif
  #:endfor
#:enddef
