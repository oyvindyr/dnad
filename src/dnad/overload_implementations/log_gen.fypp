
#:def log_d(i)
    ${i.elemental}$ function log__${i.sn}$(u) result(res)
        type(${i.type_name}$), intent(in) :: u
        type(${i.type_name}$) :: res
        
        res%f = log(u%f)
        res%g = u%g/u%f
    end function
#:enddef

#:def log_hd(i)
    ${i.elemental}$ function log__${i.sn}$(u) result(res)
        type(${i.type_name}$), intent(in) :: u
        type(${i.type_name}$) :: res
      #:if i.gdim is None
        integer :: i, j, k
      #:endif
        real(${i.real_kind}$) :: t0
        
        t0 = 1.0_${i.real_kind}$/u%d%f
        res%d%f = log(u%d%f)
        res%d%g = t0*u%d%g
      #:if i.gdim == 2
        
        res%h(1) = t0*(-t0*u%d%g(1)*u%d%g(1) + u%h(1))
        res%h(2) = t0*(-t0*u%d%g(2)*u%d%g(1) + u%h(2))
        res%h(3) = t0*(-t0*u%d%g(2)*u%d%g(2) + u%h(3))
      #:elif i.gdim == 3
        
        res%h(1) = t0*(-t0*u%d%g(1)*u%d%g(1) + u%h(1))
        res%h(2) = t0*(-t0*u%d%g(2)*u%d%g(1) + u%h(2))
        res%h(3) = t0*(-t0*u%d%g(3)*u%d%g(1) + u%h(3))
        res%h(4) = t0*(-t0*u%d%g(2)*u%d%g(2) + u%h(4))
        res%h(5) = t0*(-t0*u%d%g(3)*u%d%g(2) + u%h(5))
        res%h(6) = t0*(-t0*u%d%g(3)*u%d%g(3) + u%h(6))
      #:else
        k = 0
        do j = 1, size(res%d%g)
            do i = j, size(res%d%g)
                k = k + 1
                res%h(k) = t0*(-t0*u%d%g(i)*u%d%g(j) + u%h(k))
            end do
        end do
      #:endif
    end function
#:enddef

