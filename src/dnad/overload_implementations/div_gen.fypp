
#:def div_d(i)
    ${i.elemental}$ function div__${i.sn}$_${i.sn}$(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
        real(${i.real_kind}$) :: t0,t1
        
        t0 = 1.0_${i.real_kind}$/v%f
        t1 = t0*u%f
        res%f = t1
        res%g = t0*(-t1*v%g + u%g)
    end function
    ${i.elemental}$ function div__${i.sn}$_r(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        real(${i.real_kind}$), intent(in) :: v
        type(${i.type_name}$) :: res
        real(${i.real_kind}$) :: t0
        
        t0 = 1.0_${i.real_kind}$/v
        res%f = t0*u%f
        res%g = t0*u%g
    end function
    ${i.elemental}$ function div__r_${i.sn}$(u, v) result(res)
        real(${i.real_kind}$), intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%f = u/v%f
        res%g = -u*v%g/v%f**2
    end function
    ${i.elemental}$ function div__${i.sn}$_i(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        integer, intent(in) :: v
        type(${i.type_name}$) :: res
        real(${i.real_kind}$) :: t0
        
        t0 = 1.0_${i.real_kind}$/v
        res%f = t0*u%f
        res%g = t0*u%g
    end function
    ${i.elemental}$ function div__i_${i.sn}$(u, v) result(res)
        integer, intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%f = u/v%f
        res%g = -u*v%g/v%f**2
    end function
#:enddef

#:def div_hd(i)
    ${i.elemental}$ function div__${i.sn}$_${i.sn}$(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
      #:if i.gdim is None
        integer :: i, j, k
      #:endif
        real(${i.real_kind}$) :: t0,t1
        
        t0 = 1.0_${i.real_kind}$/v%d%f
        t1 = t0*u%d%f
        res%d%f = t1
        res%d%g = t0*(-t1*v%d%g + u%d%g)
      #:if i.gdim == 2
        
        res%h(1) = t0*(-t0*u%d%g(1)*v%d%g(1) - t0*v%d%g(1)*(-2*t1*v%d%g(1) + u%d%g(1)) - t1* &
      v%h(1) + u%h(1))
        res%h(2) = t0*(-t0*u%d%g(1)*v%d%g(2) - t0*v%d%g(1)*(-2*t1*v%d%g(2) + u%d%g(2)) - t1* &
      v%h(2) + u%h(2))
        res%h(3) = t0*(-t0*u%d%g(2)*v%d%g(2) - t0*v%d%g(2)*(-2*t1*v%d%g(2) + u%d%g(2)) - t1* &
      v%h(3) + u%h(3))
      #:elif i.gdim == 3
        
        res%h(1) = t0*(-t0*u%d%g(1)*v%d%g(1) - t0*v%d%g(1)*(-2*t1*v%d%g(1) + u%d%g(1)) - t1* &
      v%h(1) + u%h(1))
        res%h(2) = t0*(-t0*u%d%g(1)*v%d%g(2) - t0*v%d%g(1)*(-2*t1*v%d%g(2) + u%d%g(2)) - t1* &
      v%h(2) + u%h(2))
        res%h(3) = t0*(-t0*u%d%g(1)*v%d%g(3) - t0*v%d%g(1)*(-2*t1*v%d%g(3) + u%d%g(3)) - t1* &
      v%h(3) + u%h(3))
        res%h(4) = t0*(-t0*u%d%g(2)*v%d%g(2) - t0*v%d%g(2)*(-2*t1*v%d%g(2) + u%d%g(2)) - t1* &
      v%h(4) + u%h(4))
        res%h(5) = t0*(-t0*u%d%g(2)*v%d%g(3) - t0*v%d%g(2)*(-2*t1*v%d%g(3) + u%d%g(3)) - t1* &
      v%h(5) + u%h(5))
        res%h(6) = t0*(-t0*u%d%g(3)*v%d%g(3) - t0*v%d%g(3)*(-2*t1*v%d%g(3) + u%d%g(3)) - t1* &
      v%h(6) + u%h(6))
      #:else
        k = 0
        do j = 1, size(res%d%g)
            do i = j, size(res%d%g)
                k = k + 1
                res%h(k) = t0*(-t0*u%d%g(j)*v%d%g(i) - t0*v%d%g(j)*(-2*t1*v%d%g(i) + u%d%g(i)) - t1* &
      v%h(k) + u%h(k))
            end do
        end do
      #:endif
    end function
    ${i.elemental}$ function div__${i.sn}$_r(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        real(${i.real_kind}$), intent(in) :: v
        type(${i.type_name}$) :: res
        real(${i.real_kind}$) :: t0
        
        t0 = 1.0_${i.real_kind}$/v
        res%d%f = t0*u%d%f
        res%d%g = t0*u%d%g
        res%h = t0*u%h
    end function
    ${i.elemental}$ function div__r_${i.sn}$(u, v) result(res)
        real(${i.real_kind}$), intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
      #:if i.gdim is None
        integer :: i, j, k
      #:endif
        real(${i.real_kind}$) :: t0,t1
        
        t0 = 1.0_${i.real_kind}$/v%d%f
        t1 = u/v%d%f**2
        res%d%f = t0*u
        res%d%g = -t1*v%d%g
      #:if i.gdim == 2
        
        res%h(1) = t1*(2*t0*v%d%g(1)*v%d%g(1) - v%h(1))
        res%h(2) = t1*(2*t0*v%d%g(2)*v%d%g(1) - v%h(2))
        res%h(3) = t1*(2*t0*v%d%g(2)*v%d%g(2) - v%h(3))
      #:elif i.gdim == 3
        
        res%h(1) = t1*(2*t0*v%d%g(1)*v%d%g(1) - v%h(1))
        res%h(2) = t1*(2*t0*v%d%g(2)*v%d%g(1) - v%h(2))
        res%h(3) = t1*(2*t0*v%d%g(3)*v%d%g(1) - v%h(3))
        res%h(4) = t1*(2*t0*v%d%g(2)*v%d%g(2) - v%h(4))
        res%h(5) = t1*(2*t0*v%d%g(3)*v%d%g(2) - v%h(5))
        res%h(6) = t1*(2*t0*v%d%g(3)*v%d%g(3) - v%h(6))
      #:else
        k = 0
        do j = 1, size(res%d%g)
            do i = j, size(res%d%g)
                k = k + 1
                res%h(k) = t1*(2*t0*v%d%g(i)*v%d%g(j) - v%h(k))
            end do
        end do
      #:endif
    end function
    ${i.elemental}$ function div__${i.sn}$_i(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        integer, intent(in) :: v
        type(${i.type_name}$) :: res
        real(${i.real_kind}$) :: t0
        
        t0 = 1.0_${i.real_kind}$/v
        res%d%f = t0*u%d%f
        res%d%g = t0*u%d%g
        res%h = t0*u%h
    end function
    ${i.elemental}$ function div__i_${i.sn}$(u, v) result(res)
        integer, intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
      #:if i.gdim is None
        integer :: i, j, k
      #:endif
        real(${i.real_kind}$) :: t0,t1
        
        t0 = 1.0_${i.real_kind}$/v%d%f
        t1 = u/v%d%f**2
        res%d%f = t0*u
        res%d%g = -t1*v%d%g
      #:if i.gdim == 2
        
        res%h(1) = t1*(2*t0*v%d%g(1)*v%d%g(1) - v%h(1))
        res%h(2) = t1*(2*t0*v%d%g(2)*v%d%g(1) - v%h(2))
        res%h(3) = t1*(2*t0*v%d%g(2)*v%d%g(2) - v%h(3))
      #:elif i.gdim == 3
        
        res%h(1) = t1*(2*t0*v%d%g(1)*v%d%g(1) - v%h(1))
        res%h(2) = t1*(2*t0*v%d%g(2)*v%d%g(1) - v%h(2))
        res%h(3) = t1*(2*t0*v%d%g(3)*v%d%g(1) - v%h(3))
        res%h(4) = t1*(2*t0*v%d%g(2)*v%d%g(2) - v%h(4))
        res%h(5) = t1*(2*t0*v%d%g(3)*v%d%g(2) - v%h(5))
        res%h(6) = t1*(2*t0*v%d%g(3)*v%d%g(3) - v%h(6))
      #:else
        k = 0
        do j = 1, size(res%d%g)
            do i = j, size(res%d%g)
                k = k + 1
                res%h(k) = t1*(2*t0*v%d%g(i)*v%d%g(j) - v%h(k))
            end do
        end do
      #:endif
    end function
#:enddef

