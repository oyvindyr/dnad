
#:def sqrt_d(i)
    ${i.elemental}$ function sqrt__${i.sn}$(u) result(res)
        type(${i.type_name}$), intent(in) :: u
        type(${i.type_name}$) :: res
        real(${i.real_kind}$) :: t0
      #:if i.stringent
        integer :: i
      #:endif
        
        t0 = sqrt(u%f)
        res%f = t0
      #:if i.stringent
        if (res%f /= 0) then
            res%g = 0.5_${i.real_kind}$*u%g/t0
        else
            do i = 1, size(u%g)
                if (u%g(i) == 0) then
                    res%g(i) = 0
                else
                    res%g(i) = set_NaN()
                end if
            end do
        end if
      #:else
        res%g = 0.5_${i.real_kind}$*u%g/t0
      #:endif
    end function

#:enddef

#:def sqrt_hd(i)
    ${i.elemental}$ function sqrt__${i.sn}$(u) result(res)
        type(${i.type_name}$), intent(in) :: u
        type(${i.type_name}$) :: res
      #:if i.gdim is None
        integer :: i, j, k
      #:elif i.stringent
        integer :: i
      #:endif
        real(${i.real_kind}$) :: t0,t1
        
        t0 = sqrt(u%d%f)
        t1 = 1.0_${i.real_kind}$/t0
        res%d%f = t0
      #:if i.stringent
        if (res%d%f /= 0) then
            res%d%g = 0.5_${i.real_kind}$*t1*u%d%g
          #:if i.gdim == 2
            res%h(1) = (0.25_${i.real_kind}$)*t1*(2*u%h(1) - u%d%g(1)*u%d%g(1)/u%d%f)
            res%h(2) = (0.25_${i.real_kind}$)*t1*(2*u%h(2) - u%d%g(2)*u%d%g(1)/u%d%f)
            res%h(3) = (0.25_${i.real_kind}$)*t1*(2*u%h(3) - u%d%g(2)*u%d%g(2)/u%d%f)
          #:elif i.gdim == 3
            res%h(1) = (0.25_${i.real_kind}$)*t1*(2*u%h(1) - u%d%g(1)*u%d%g(1)/u%d%f)
            res%h(2) = (0.25_${i.real_kind}$)*t1*(2*u%h(2) - u%d%g(2)*u%d%g(1)/u%d%f)
            res%h(3) = (0.25_${i.real_kind}$)*t1*(2*u%h(3) - u%d%g(3)*u%d%g(1)/u%d%f)
            res%h(4) = (0.25_${i.real_kind}$)*t1*(2*u%h(4) - u%d%g(2)*u%d%g(2)/u%d%f)
            res%h(5) = (0.25_${i.real_kind}$)*t1*(2*u%h(5) - u%d%g(3)*u%d%g(2)/u%d%f)
            res%h(6) = (0.25_${i.real_kind}$)*t1*(2*u%h(6) - u%d%g(3)*u%d%g(3)/u%d%f)
          #:else
            k = 0
            do j = 1, size(res%d%g)
                do i = j, size(res%d%g)
                    k = k + 1
                    res%h(k) = (0.25_${i.real_kind}$)*t1*(2*u%h(k) - u%d%g(i)*u%d%g(j)/u%d%f)
                end do
            end do
          #:endif
        else
            do i = 1, size(res%d%g)
                if (u%d%g(i) == 0) then
                    res%d%g(i) = 0
                else
                    res%d%g(i) = set_NaN()
                end if
            end do
            res%h = set_NaN() ! Not sure if this is correct..
        end if
      #:else
        res%d%g = 0.5_${i.real_kind}$*t1*u%d%g
      #:if i.gdim == 2
        res%h(1) = (0.25_${i.real_kind}$)*t1*(2*u%h(1) - u%d%g(1)*u%d%g(1)/u%d%f)
        res%h(2) = (0.25_${i.real_kind}$)*t1*(2*u%h(2) - u%d%g(2)*u%d%g(1)/u%d%f)
        res%h(3) = (0.25_${i.real_kind}$)*t1*(2*u%h(3) - u%d%g(2)*u%d%g(2)/u%d%f)
      #:elif i.gdim == 3
        res%h(1) = (0.25_${i.real_kind}$)*t1*(2*u%h(1) - u%d%g(1)*u%d%g(1)/u%d%f)
        res%h(2) = (0.25_${i.real_kind}$)*t1*(2*u%h(2) - u%d%g(2)*u%d%g(1)/u%d%f)
        res%h(3) = (0.25_${i.real_kind}$)*t1*(2*u%h(3) - u%d%g(3)*u%d%g(1)/u%d%f)
        res%h(4) = (0.25_${i.real_kind}$)*t1*(2*u%h(4) - u%d%g(2)*u%d%g(2)/u%d%f)
        res%h(5) = (0.25_${i.real_kind}$)*t1*(2*u%h(5) - u%d%g(3)*u%d%g(2)/u%d%f)
        res%h(6) = (0.25_${i.real_kind}$)*t1*(2*u%h(6) - u%d%g(3)*u%d%g(3)/u%d%f)
      #:else
        k = 0
        do j = 1, size(res%d%g)
            do i = j, size(res%d%g)
                k = k + 1
                res%h(k) = (0.25_${i.real_kind}$)*t1*(2*u%h(k) - u%d%g(i)*u%d%g(j)/u%d%f)
            end do
        end do
      #:endif
      #:endif
    end function
#:enddef

