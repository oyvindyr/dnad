
#:def mult_d(i)
    ${i.elemental}$ function mult__${i.sn}$_${i.sn}$(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%f = u%f*v%f
        res%g = u%g*v%f + u%f*v%g
    end function
    ${i.elemental}$ function mult__${i.sn}$_r(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        real(${i.real_kind}$), intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%f = u%f*v
        res%g = u%g*v
    end function
    ${i.elemental}$ function mult__r_${i.sn}$(u, v) result(res)
        real(${i.real_kind}$), intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%f = u*v%f
        res%g = u*v%g
    end function
    ${i.elemental}$ function mult__${i.sn}$_i(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        integer, intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%f = u%f*v
        res%g = u%g*v
    end function
    ${i.elemental}$ function mult__i_${i.sn}$(u, v) result(res)
        integer, intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%f = u*v%f
        res%g = u*v%g
    end function
#:enddef

#:def mult_hd(i)
    ${i.elemental}$ function mult__${i.sn}$_${i.sn}$(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
      #:if i.gdim is None
        integer :: i, j, k
      #:endif
        
        res%d%f = u%d%f*v%d%f
        res%d%g = u%d%g*v%d%f + u%d%f*v%d%g
      #:if i.gdim == 2
        
        res%h(1) = u%h(1)*v%d%f + u%d%g(1)*v%d%g(1) + u%d%g(1)*v%d%g(1) + u%d%f*v%h(1)
        res%h(2) = u%h(2)*v%d%f + u%d%g(2)*v%d%g(1) + u%d%g(1)*v%d%g(2) + u%d%f*v%h(2)
        res%h(3) = u%h(3)*v%d%f + u%d%g(2)*v%d%g(2) + u%d%g(2)*v%d%g(2) + u%d%f*v%h(3)
      #:elif i.gdim == 3
        
        res%h(1) = u%h(1)*v%d%f + u%d%g(1)*v%d%g(1) + u%d%g(1)*v%d%g(1) + u%d%f*v%h(1)
        res%h(2) = u%h(2)*v%d%f + u%d%g(2)*v%d%g(1) + u%d%g(1)*v%d%g(2) + u%d%f*v%h(2)
        res%h(3) = u%h(3)*v%d%f + u%d%g(3)*v%d%g(1) + u%d%g(1)*v%d%g(3) + u%d%f*v%h(3)
        res%h(4) = u%h(4)*v%d%f + u%d%g(2)*v%d%g(2) + u%d%g(2)*v%d%g(2) + u%d%f*v%h(4)
        res%h(5) = u%h(5)*v%d%f + u%d%g(3)*v%d%g(2) + u%d%g(2)*v%d%g(3) + u%d%f*v%h(5)
        res%h(6) = u%h(6)*v%d%f + u%d%g(3)*v%d%g(3) + u%d%g(3)*v%d%g(3) + u%d%f*v%h(6)
      #:else
        k = 0
        do j = 1, size(res%d%g)
            do i = j, size(res%d%g)
                k = k + 1
                res%h(k) = u%h(k)*v%d%f + u%d%g(i)*v%d%g(j) + u%d%g(j)*v%d%g(i) + u%d%f*v%h(k)
            end do
        end do
      #:endif
    end function
    ${i.elemental}$ function mult__${i.sn}$_r(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        real(${i.real_kind}$), intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%d%f = u%d%f*v
        res%d%g = u%d%g*v
        res%h = u%h*v
    end function
    ${i.elemental}$ function mult__r_${i.sn}$(u, v) result(res)
        real(${i.real_kind}$), intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%d%f = u*v%d%f
        res%d%g = u*v%d%g
        res%h = u*v%h
    end function
    ${i.elemental}$ function mult__${i.sn}$_i(u, v) result(res)
        type(${i.type_name}$), intent(in) :: u
        integer, intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%d%f = u%d%f*v
        res%d%g = u%d%g*v
        res%h = u%h*v
    end function
    ${i.elemental}$ function mult__i_${i.sn}$(u, v) result(res)
        integer, intent(in) :: u
        type(${i.type_name}$), intent(in) :: v
        type(${i.type_name}$) :: res
        
        res%d%f = u*v%d%f
        res%d%g = u*v%d%g
        res%h = u*v%h
    end function
#:enddef

