
#:def add_d(dual_type, dual_sn, real_kind, is_pure)
    #:if is_pure
        #:set elemental_purity = "elemental"
    #:else
        #:set elemental_purity = "impure elemental"
    #:endif
    ${elemental_purity}$ function add__${dual_sn}$(u) result(res)
        type(${dual_type}$), intent(in) :: u
        type(${dual_type}$) :: res
        
        res%f = u%f
        res%g = u%g
    end function
    ${elemental_purity}$ function add__${dual_sn}$_${dual_sn}$(u, v) result(res)
        type(${dual_type}$), intent(in) :: u
        type(${dual_type}$), intent(in) :: v
        type(${dual_type}$) :: res
        
        res%f = u%f + v%f
        res%g = u%g + v%g
    end function
    ${elemental_purity}$ function add__${dual_sn}$_r(u, v) result(res)
        type(${dual_type}$), intent(in) :: u
        real(${real_kind}$), intent(in) :: v
        type(${dual_type}$) :: res
        
        res%f = u%f + v
        res%g = u%g
    end function
    ${elemental_purity}$ function add__r_${dual_sn}$(u, v) result(res)
        real(${real_kind}$), intent(in) :: u
        type(${dual_type}$), intent(in) :: v
        type(${dual_type}$) :: res
        
        res%f = u + v%f
        res%g = v%g
    end function
    ${elemental_purity}$ function add__${dual_sn}$_i(u, v) result(res)
        type(${dual_type}$), intent(in) :: u
        integer, intent(in) :: v
        type(${dual_type}$) :: res
        
        res%f = u%f + v
        res%g = u%g
    end function
    ${elemental_purity}$ function add__i_${dual_sn}$(u, v) result(res)
        integer, intent(in) :: u
        type(${dual_type}$), intent(in) :: v
        type(${dual_type}$) :: res
        
        res%f = u + v%f
        res%g = v%g
    end function
#:enddef

#:def add_hd(dual_type, dual_sn, real_kind, is_pure)
    #:if is_pure
        #:set elemental_purity = "elemental"
    #:else
        #:set elemental_purity = "impure elemental"
    #:endif
    ${elemental_purity}$ function add__${dual_sn}$(u) result(res)
        type(${dual_type}$), intent(in) :: u
        type(${dual_type}$) :: res
        
        res%d%f = u%d%f
        res%d%g = u%d%g
        res%h = u%h
    end function
    ${elemental_purity}$ function add__${dual_sn}$_${dual_sn}$(u, v) result(res)
        type(${dual_type}$), intent(in) :: u
        type(${dual_type}$), intent(in) :: v
        type(${dual_type}$) :: res
        
        res%d%f = u%d%f + v%d%f
        res%d%g = u%d%g + v%d%g
        res%h = u%h + v%h
    end function
    ${elemental_purity}$ function add__${dual_sn}$_r(u, v) result(res)
        type(${dual_type}$), intent(in) :: u
        real(${real_kind}$), intent(in) :: v
        type(${dual_type}$) :: res
        
        res%d%f = u%d%f + v
        res%d%g = u%d%g
        res%h = u%h
    end function
    ${elemental_purity}$ function add__r_${dual_sn}$(u, v) result(res)
        real(${real_kind}$), intent(in) :: u
        type(${dual_type}$), intent(in) :: v
        type(${dual_type}$) :: res
        
        res%d%f = u + v%d%f
        res%d%g = v%d%g
        res%h = v%h
    end function
    ${elemental_purity}$ function add__${dual_sn}$_i(u, v) result(res)
        type(${dual_type}$), intent(in) :: u
        integer, intent(in) :: v
        type(${dual_type}$) :: res
        
        res%d%f = u%d%f + v
        res%d%g = u%d%g
        res%h = u%h
    end function
    ${elemental_purity}$ function add__i_${dual_sn}$(u, v) result(res)
        integer, intent(in) :: u
        type(${dual_type}$), intent(in) :: v
        type(${dual_type}$) :: res
        
        res%d%f = u + v%d%f
        res%d%g = v%d%g
        res%h = v%h
    end function
#:enddef

