
#:def ge(i)
    #:if i.hyper
        #:set f = "d%f"
    #:else
        #:set f = "f"
    #:endif
    ${i.elemental}$  function ge__${i.sn}$_${i.sn}$(lhs, rhs) result(res)
         type(${i.type_name}$), intent(in) :: lhs, rhs
         logical :: res

         res = (lhs%${f}$ >= rhs%${f}$)

    end function
    ${i.elemental}$  function ge__${i.sn}$_i(lhs, rhs) result(res)
         type(${i.type_name}$), intent(in) :: lhs
         integer, intent(in) :: rhs
         logical :: res

         res = (lhs%${f}$ >= rhs)

    end function
    ${i.elemental}$  function ge__${i.sn}$_r(lhs, rhs) result(res)
         type(${i.type_name}$), intent(in) :: lhs
         real(${i.real_kind}$), intent(in) :: rhs
         logical :: res

         res = (lhs%${f}$ >= rhs)

    end function
    ${i.elemental}$  function ge__i_${i.sn}$(lhs, rhs) result(res)
         integer, intent(in) :: lhs
         type(${i.type_name}$), intent(in) :: rhs
         logical :: res

         res = (lhs >= rhs%${f}$)

    end function
    ${i.elemental}$  function ge__r_${i.sn}$(lhs, rhs) result(res)
         real(${i.real_kind}$), intent(in) :: lhs
         type(${i.type_name}$), intent(in) :: rhs
         logical :: res

         res = (lhs >= rhs%${f}$)

    end function
#:enddef
