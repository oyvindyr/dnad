#:def dnad_getter_interfaces(kinds)
    interface fvalue
        !! Extract function value from a real, dual or hyper-dual number
        module procedure fvalue__r
        module procedure fvalue__r1
        module procedure fvalue__r2
      #:for k in kinds
        module procedure fvalue__d_${k.suffix}$
        module procedure fvalue__d_${k.suffix}$_r1
        module procedure fvalue__d_${k.suffix}$_r2
       #:if k.hyper
        module procedure fvalue__hd_${k.suffix}$
        module procedure fvalue__hd_${k.suffix}$_r1
        module procedure fvalue__hd_${k.suffix}$_r2
       #:endif
      #:endfor
    end interface

    interface downgrade
        !! Downgrade a hyper-dual number to a dual number, a dual number to a real, or a real to itself.
        module procedure fvalue__r   ! Real to real
        module procedure fvalue__r1  ! Real to real (rank-1)
        module procedure fvalue__r2  ! Real to real (rank-2)
      #:for k in kinds
        module procedure fvalue__d_${k.suffix}$    ! Dual to real
        module procedure fvalue__d_${k.suffix}$_r1 ! Dual to real (rank-1)
        module procedure fvalue__d_${k.suffix}$_r2 ! Dual to real (rank-2)
       #:if k.hyper
        module procedure downgrade__hd_${k.suffix}$ ! Hyper-dual to dual
       #:endif
      #:endfor        
    end interface

    interface gradient
        !! Extract gradient from a dual or hyper-dual number
      #:for k in kinds
        module procedure gradient__d_${k.suffix}$
       #:if k.hyper
        module procedure gradient__hd_${k.suffix}$
       #:endif
      #:endfor
    end interface

    interface gradient_d
        !! Extract gradient from a dual or hyper-dual number. In the hyper-dual case, the gradient is dual valued.
      #:for k in kinds
        module procedure gradient__d_${k.suffix}$ ! Same implementations as gradient()
       #:if k.hyper
        module procedure gradient_d__hd_${k.suffix}$
       #:endif
      #:endfor
    end interface

    interface hessian 
        !! Extract Hessian from a hyper-dual number
      #:for k in kinds
       #:if k.hyper
        module procedure hessian__hd_${k.suffix}$
       #:endif
      #:endfor
    end interface
#:enddef

#:def dnad_getter_implementations(kinds, config)

    pure function fvalue__r(fi) result(f)
        real(${config.real_kind}$), intent(in) :: fi
        real(${config.real_kind}$) :: f
        f = fi
    end function
    pure function fvalue__r1(fi) result(f)
        real(${config.real_kind}$), intent(in) :: fi(:)
        real(${config.real_kind}$) :: f(size(fi))
        f = fi
    end function
    pure function fvalue__r2(fi) result(f)
        real(${config.real_kind}$), intent(in) :: fi(:,:)
        real(${config.real_kind}$) :: f(size(fi, 1), size(fi, 2))
        f = fi
    end function
  #:for k in kinds
    pure function fvalue__d_${k.suffix}$(d) result(f)
        type(dual__${k.suffix}$_t), intent(in) :: d
        real(${config.real_kind}$) :: f
        f = d%f
    end function
    pure function fvalue__d_${k.suffix}$_r1(d) result(f)
        type(dual__${k.suffix}$_t), intent(in) :: d(:)
        real(${config.real_kind}$) :: f(size(d))
        f = d%f
    end function
    pure function fvalue__d_${k.suffix}$_r2(d) result(f)
        type(dual__${k.suffix}$_t), intent(in) :: d(:,:)
        real(${config.real_kind}$) :: f(size(d,1),size(d,2))
        f = d%f
    end function
   #:if k.hyper
    pure function fvalue__hd_${k.suffix}$(hd) result(f)
        type(hdual__${k.suffix}$_t), intent(in) :: hd
        real(${config.real_kind}$) :: f
        f = hd%d%f
    end function
    pure function fvalue__hd_${k.suffix}$_r1(hd) result(f)
        type(hdual__${k.suffix}$_t), intent(in) :: hd(:)
        real(${config.real_kind}$) :: f(size(hd))
        f = hd%d%f
    end function
    pure function fvalue__hd_${k.suffix}$_r2(hd) result(f)
        type(hdual__${k.suffix}$_t), intent(in) :: hd(:,:)
        real(${config.real_kind}$) :: f(size(hd,1),size(hd,2))
        f = hd%d%f
    end function
   #:endif
  #:endfor

  #:for k in kinds
   #:if k.hyper
    pure function downgrade__hd_${k.suffix}$(hd) result(d)
        type(hdual__${k.suffix}$_t), intent(in) :: hd
        type(dual__${k.suffix}$_t) :: d
        d = hd%d
    end function
   #:endif
  #:endfor

  #:for k in kinds
    pure function gradient__d_${k.suffix}$(d) result(g)
        type(dual__${k.suffix}$_t), intent(in) :: d
        real(${config.real_kind}$) :: g(size(d%g))
        g = d%g
    end function
   #:if k.hyper
    pure function gradient__hd_${k.suffix}$(hd) result(g)
        type(hdual__${k.suffix}$_t), intent(in) :: hd
        real(${config.real_kind}$) :: g(size(hd%d%g))
        g = hd%d%g
    end function
    pure function gradient_d__hd_${k.suffix}$(hd) result(g)
        type(hdual__${k.suffix}$_t), intent(in) :: hd
        type(dual__${k.suffix}$_t) :: g(size(hd%d%g))

        real(dp) :: hess(size(hd%d%g), size(hd%d%g))
        integer :: i

        hess = hessian(hd)
        do i = 1, size(hd%d%g)
            g(i)%f = hd%d%g(i)
            g(i)%g = hess(:,i)
        end do
    end function
   #:endif
  #:endfor

  #:for k in kinds
   #:if k.hyper
    pure function hessian__hd_${k.suffix}$(hd) result(m)
        type(hdual__${k.suffix}$_t), intent(in) :: hd
        real(${config.real_kind}$) :: m(size(hd%d%g), size(hd%d%g))
        
        integer i, j, k

        k = 0
        do j = 1, size(hd%d%g)
            k = k + 1
            m(j, j) = hd%h(k)
            do i = j+1, size(hd%d%g)
                k = k + 1
                m(i, j) = hd%h(k)
                m(j, i) = hd%h(k)
            end do
        end do

    end function
   #:endif
  #:endfor
#:enddef
